<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background"
    android:elevation="6dp"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_active_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <FrameLayout
                android:id="@+id/widget_icon_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_prayer_icon_circle"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/widget_bg_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_crescent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="الصلاة التالية"
                    android:textColor="#BFFFFFFF"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_next_prayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:text="المغرب"
                    android:textColor="#FFF4C76A"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_small_hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:background="@drawable/widget_glass_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Chronometer
                android:id="@+id/widget_time_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="متبقي"
                android:textColor="#FFF4C76A"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/widget_dhikr"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="2"
                android:text="أستغفر الله وأتوب إليه"
                android:textColor="#E6FFFFFF"
                android:textDirection="locale"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="الأحد 23 أغسطس"
                    android:textColor="#BFFFFFFF"
                    android:textSize="7sp" />

                <TextView
                    android:id="@+id/widget_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:layoutDirection="ltr"
                    android:maxLines="1"
                    android:text="18:29"
                    android:textColor="#FFFFFFFF"
                    android:textDirection="ltr"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_prayer_icon_circle"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/ic_crescent" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:text="افتح التطبيق مرة واحدة لتحميل المواقيت"
            android:textColor="#E6FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
