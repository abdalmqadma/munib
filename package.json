{
  "name": "munib-security-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:web-auth": "node --test test/web_auth_actions_test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-munib-tests \"node --test test/firestore_rules_test.mjs\"",
    "test:firebase": "npm run test:web-auth && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.29.0"
  }
}
