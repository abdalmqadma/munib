rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfilePhoto(fileName) {
      return signedIn()
          && fileName.matches(request.auth.uid + '\\.(jpg|jpeg|png)');
    }

    match /profile_photos/{fileName} {
      allow read: if ownsProfilePhoto(fileName);
      allow create, update: if ownsProfilePhoto(fileName)
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if ownsProfilePhoto(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
